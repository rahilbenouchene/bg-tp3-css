  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
.container {
    /*background-color: red;*/
    width: 90%;
    margin: 0 auto ;
    border: 1px solid black;
    max-width: 1100px;
	/* 2. Hauteur automatique selon le contenu (au lieu de 100px statique):    height: 100px; */
    height: auto;
}
footer {
    background-color: red;
    width: 100%;
    height: 100px;
    border: 1px solid black;
}
.main-nav, .showcase {
    background-color: #CCCCCC;
    width: 100%;
    height: 60px;
    border: 1px solid black;
}
 .ruban, .follow, .links, .sub-footer, #bigData-intro {
    background-color: #d3eaac;
    width: 100%;
    height: 100px;
    border: 1px solid black;
}
.main-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;/* pour l'espace entre chaque element */
    height: 60px;
    padding: 20px 0;
    background-color: #ffffff;
    font-size: 13px;
}


/*step 4*/

.main-menu {
    display: flex;
    list-style: none;
    flex: 1;
    margin-left: 20px;
}

.logo{
	width: 110px;
}


.main-menu li {
    margin-right: 10px;
}

.main-menu a {
    color: #262626;
    text-decoration: none;
    padding-bottom: 2px;
}

.main-menu a:hover {
    border-bottom: 2px solid #262626;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #ffffff;
    color: #000000;
    font-size: 15px;
    line-height: 1.5;
}
	
/* --- Menu de droite (Recherche & Panier) --- */
.right-menu {
    display: flex;
    list-style: none;
    align-items: center;
}

.right-menu li {
    margin-left: 10px;
}

.right-menu a {
    color: #262626;
    text-decoration: none;
}









/* --- Étape 5 : Showcase --- */
.showcase {
    width: 100%;
    height: 400px;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 20px;
}

.showcase h2,
.showcase p {
    margin-bottom: 10px;
}

.btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background-color: #378ff5;
    color: #ffffff;
    border-radius: 20px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    opacity: 0.8;
}

.dark {
    color: #ffffff;
}

.dark .btn {
    background-color: #f4f4f4;
    color: #333333;
}







/* --- Étape 6 : Home-cards --- */
.home-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
    background-color: #ffffff;
    width: auto;
    border: none; /* Supprime l'ancienne bordure de test */
}

.home-cards img {
    width: 100%;
    margin-bottom: 20px;
}

.home-cards h3 {
    margin-bottom: 5px;
}

.home-cards a {
    display: inline-block;
    color: #0067b8;
    text-transform: uppercase;
    font-weight: bold;
    margin-top: 10px;
    text-decoration: none;
}

.home-cards a i {
    margin-left: 5px;
    transition: transform 0.3s ease;
}

.home-cards a:hover i {
    transform: translateX(10px); /* Décale l'icône de 10px vers la droite au survol */
}







/* --- Étape 7 : Showcase Bigdata --- */
#bigData-intro {
    width: 100%;
    height: 350px;
    margin-bottom: 20px;
    padding-bottom: 100px;
    background: url('../img/bigdata-intro.jpg') no-repeat center center / cover;
    border: none; /* Supprime l'ancienne bordure de test */
}

#bigData-intro .content {
    width: 40%;
    color: #262626;
    padding: 50px 0 0 30px;
}

#bigData-intro h2 {
    margin-bottom: 10px;
}

#bigData-intro p {
    margin: 10px 0 20px 0;
}











/* --- Étape 9 : Ruban --- */
.ruban {
    width: 100%;
    height: 350px;
    margin-bottom: 20px;
    background: url('../img/ribbon.jpg') no-repeat center center / cover;
    border: none;
    display: flex;
    align-items: flex-start; 
}
.ruban .content {
    width: 55%;
    color: #ffffff;
    padding: 80px 0 0 30px;
}

.ruban h2 {
    margin-bottom: 10px;
}

.ruban p {
    margin: 10px 0 20px 0;
}

.dark .btn {
    background-color: #03254c;
    color: #ffffff;
}


/* --- Étape 10 : Ruban --- */

.follow {
    background-color: #ffffff; /* Fond blanc */
    display: flex; /* Affichage en flexbox */
    align-items: center; /* Alignement vertical au centre */
    justify-content: flex-start; /* Alignement à gauche */
}

.follow * {
    margin-right: 10px; /* Espacement droit de 10px pour tous les éléments */
}

.follow span {
    color: #000000; /* Icônes en noir */
    font-size: 30px; /* Taille de police de 30px */
}



/* --- Étape 11 : Ruban --- */
.links {
    background-color: #f2f2f2; /* Fond gris clair */
    color: #616161; /* Texte gris moyen */
    padding-top: 35px; /* Espacement vertical (haut) de 35 px */
    padding-bottom: 35px; /* Espacement vertical (bas) de 35 px */
    height: auto; /* Hauteur automatique */
    font-size: 12px; /* Taille de police de 12 px */
    border: none; /* Bordure désactivée */
}

.links-inner {
    display: grid; /* Organisation en grille */
    grid-template-columns: repeat(5, 1fr); /* Grille de cinq colonnes égales */
    gap: 10px; /* Séparées par un espace de 10 px */
    max-width: 1000px; /* Limitées à une largeur maximale de 1000 px */
    margin: 0 auto; /* Centrées horizontalement */
    padding-left: 20px; /* Padding horizontal de 20 px */
    padding-right: 20px; /* Padding horizontal de 20 px */
}

.links li {
    line-height: 2.8; /* Interligne de 2.8 pour les éléments de liste */
}





/* --- Étape 12 : Ruban --- */
.sub-footer {
    background-color: #f2f2f2; /* Fond gris clair */
    color: #616161; /* Texte gris moyen */
    font-size: 12px; /* Taille de police de 12 px */
    padding-top: 20px; /* Espacement vertical (haut) de 20 px */
    padding-bottom: 20px; /* Espacement vertical (bas) de 20 px */
    border: none; /* Bordure désactivée */
}

.footer-inner {
    display: flex; /* Utilisation de Flexbox pour répartir les éléments horizontalement */
    align-items: center; /* Alignement vertical centré */
    justify-content: space-between; /* Répartition horizontale */
    max-width: 1100px; /* Largeur maximale de 1100 px */
    margin: 0 auto; /* Centré sur la page */
    padding-left: 20px; /* Padding horizontal de 20 px */
    padding-right: 20px; /* Padding horizontal de 20 px */
}

.footer-inner div {
    display: flex; /* Disposés en ligne (flexbox) */
    align-items: center; /* Centrés verticalement */
    margin-bottom: 20px; /* Marge inférieure de 20 px */
}

.footer-inner div i {
    margin-right: 10px; /* Les icônes ont une marge droite de 10 px */
}

.sub-footer ul {
    display: flex; /* Affichées horizontalement */
    flex-wrap: wrap; /* Permet de passer à la ligne si nécessaire */
    list-style: none;
}

.sub-footer ul li {
    margin-right: 30px; /* Chaque élément (li) étant espacé de 30 px */
    margin-bottom: 20px; /* Séparé par une marge inférieure de 20 px */
}

/* Désactivation des bordures et définition du fond blanc pour .container */
.container {
    background-color: #ffffff;
    border: none;
}

/* Désactivation des bordures pour les autres sections spécifiées */
.sub-footer, .ruban, .home-cards, #bigData-intro, .follow, footer {
    border: none;
}






/* --- Étape 13 : Ruban --- */
/* ==========================================
   Etape 13: Responsive Design
   ========================================== */

/* Pour les écrans de largeur inférieure à 700 px */
@media(max-width: 700px) {
    /* Le menu principal passe en affichage vertical */
    .main-nav .main-menu {
        flex-direction: column;
    }

    /* Les cartes de la section .home-cards s'affichent sur 2 colonnes au lieu de 4 */
    .home-cards {
        grid-template-columns: repeat(2, 1fr);
    }

    /* L'image de la section .showcase est réduite à 60 % (si applicable, ou adaptation du conteneur/showcase) */
    .showcase {
        /* Ajustez selon la structure de votre showcase, par exemple la taille de police ou l'arrière-plan */
    }

    /* Dans #bigData-intro, le paragraphe est masqué et le titre espacé de 20 px */
    #bigData-intro p {
        display: none;
    }
    #bigData-intro h2 {
        margin-bottom: 20px;
    }

    /* Le contenu .content (ou .carbon) s'élargit à 85 % */
    .content {
        width: 85%;
    }

    /* La section .ruban devient plus haute (500 px) avec un repositionnement de l'image */
    .ruban {
        height: 500px;
    }

    /* Le pied de page .links-inner passe en 2 colonnes */
    .links-inner {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Pour les écrans de largeur inférieure à 500 px */
@media(max-width: 500px) {
    /* Les cartes (.home-cards) et les blocs de liens passent en 1 seule colonne */
    .home-cards,
    .links-inner {
        grid-template-columns: 1fr;
    }

    /* Les listes du pied de page et de la sous-section ont une taille de texte augmentée (25px) et un espacement vertical supplémentaire */
    .links ul li a,
    .sub-footer ul li a {
        font-size: 25px;
    }
    .links ul li,
    .sub-footer ul li {
        margin-bottom: 25px;
    }

    /* Le conteneur .footer-inner et ses listes s'affichent en colonne, alignées à gauche */
    .footer-inner {
        flex-direction: column;
        align-items: flex-start;
    }

    .sub-footer ul {
        flex-direction: column;
        align-items: flex-start;
    }
}