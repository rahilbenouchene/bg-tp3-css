  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
.container {
    background-color: red;
    width: 90%;
    margin: 0 auto ;
    height: 100px;
    border: 1px solid black;
    max-width: 1100px;
	/* 2. Hauteur automatique selon le contenu (au lieu de 100px statique) */
    height: auto;
}
footer {
    background-color: red;
    width: 100%;
    height: 100px;
    border: 1px solid black;
}
.main-nav, .showcase {
    background-color: #CCCCCC;
    width: 100%;
    height: 60px;
    border: 1px solid black;
}
.home-cards, .ruban, .follow, .links, .sub-footer, #bigData-intro {
    background-color: #d3eaac;
    width: 100%;
    height: 100px;
    border: 1px solid black;
}
.main-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;/* pour l'espace entre chaque element */
    height: 60px;
    padding: 20px 0;
    background-color: #ffffff;
    font-size: 13px;
}


.main-menu {
    display: flex;
    list-style: none;
    flex: 1;
    margin-left: 20px;
}

.logo{
	width: 110px;
}


.main-menu li {
    margin-right: 10px;
}

.main-menu a {
    color: #262626;
    text-decoration: none;
    padding-bottom: 2px;
}

.main-menu a:hover {
    border-bottom: 2px solid #262626;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #ffffff;
    color: #000000;
    font-size: 15px;
    line-height: 1.5;
}
	