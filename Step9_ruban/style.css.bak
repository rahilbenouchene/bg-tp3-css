  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
.container {
    /*background-color: red;*/
    width: 90%;
    margin: 0 auto ;
    height: 100px;
    border: 1px solid black;
    max-width: 1100px;
	/* 2. Hauteur automatique selon le contenu (au lieu de 100px statique) */
    height: auto;
}
footer {
    background-color: red;
    width: 100%;
    height: 100px;
    border: 1px solid black;
}
.main-nav, .showcase {
    background-color: #CCCCCC;
    width: 100%;
    height: 60px;
    border: 1px solid black;
}
 .ruban, .follow, .links, .sub-footer, #bigData-intro {
    background-color: #d3eaac;
    width: 100%;
    height: 100px;
    border: 1px solid black;
}
.main-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;/* pour l'espace entre chaque element */
    height: 60px;
    padding: 20px 0;
    background-color: #ffffff;
    font-size: 13px;
}


/*step 4*/

.main-menu {
    display: flex;
    list-style: none;
    flex: 1;
    margin-left: 20px;
}

.logo{
	width: 110px;
}


.main-menu li {
    margin-right: 10px;
}

.main-menu a {
    color: #262626;
    text-decoration: none;
    padding-bottom: 2px;
}

.main-menu a:hover {
    border-bottom: 2px solid #262626;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #ffffff;
    color: #000000;
    font-size: 15px;
    line-height: 1.5;
}
	
/* --- Menu de droite (Recherche & Panier) --- */
.right-menu {
    display: flex;
    list-style: none;
    align-items: center;
}

.right-menu li {
    margin-left: 10px;
}

.right-menu a {
    color: #262626;
    text-decoration: none;
}









/* --- Étape 5 : Showcase --- */
.showcase {
    width: 100%;
    height: 400px;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 20px;
}

.showcase h2,
.showcase p {
    margin-bottom: 10px;
}

.btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background-color: #378ff5;
    color: #ffffff;
    border-radius: 20px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    opacity: 0.8;
}

.dark {
    color: #ffffff;
}

.dark .btn {
    background-color: #f4f4f4;
    color: #333333;
}







/* --- Étape 6 : Home-cards --- */
.home-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
    background-color: #ffffff;
    width: auto;
    border: none; /* Supprime l'ancienne bordure de test */
}

.home-cards img {
    width: 100%;
    margin-bottom: 20px;
}

.home-cards h3 {
    margin-bottom: 5px;
}

.home-cards a {
    display: inline-block;
    color: #0067b8;
    text-transform: uppercase;
    font-weight: bold;
    margin-top: 10px;
    text-decoration: none;
}

.home-cards a i {
    margin-left: 5px;
    transition: transform 0.3s ease;
}

.home-cards a:hover i {
    transform: translateX(10px); /* Décale l'icône de 10px vers la droite au survol */
}







/* --- Étape 7 : Showcase Bigdata --- */
#bigData-intro {
    width: 100%;
    height: 350px;
    margin-bottom: 20px;
    padding-bottom: 100px;
    background: url('../img/bigdata-intro.jpg') no-repeat center center / cover;
    border: none; /* Supprime l'ancienne bordure de test */
}

#bigData-intro .content {
    width: 40%;
    color: #262626;
    padding: 50px 0 0 30px;
}

#bigData-intro h2 {
    margin-bottom: 10px;
}

#bigData-intro p {
    margin: 10px 0 20px 0;
}











/* --- Étape 9 : Ruban --- */

.ruban {
    width: 100%;
    height: 350px;
    margin-bottom: 20px;
    background-color: #1e3a8a; /* Fond de secours temporaire (bleu sombre) */
    /* background: url('../img/ribbon.jpg') no-repeat center center / cover; */
    border: none;
    display: flex;
    align-items: flex-start;
}

.ruban .content {
    width: 55%;
    color: #ffffff;
    padding: 80px 0 0 30px;
}

.ruban h2 {
    margin-bottom: 10px;
}

.ruban p {
    margin: 10px 0 20px 0;
}

.dark .btn {
    background-color: #03254c;
    color: #ffffff;
}